sites:
  - name: 教务处规章制度
    category: 教务政策
    entry_urls:
      - https://jwc.example.edu.cn/rule/
    allowed_domain: jwc.example.edu.cn
    max_depth: 3
    delay_seconds: 2.5
  - name: 新生指南
    category: 新生问答
    entry_urls:
      - https://zs.example.edu.cn/newstu/
    allowed_domain: zs.example.edu.cn

options:
  data_dir: data
  chunk_size: 500
  chunk_overlap: 60
  # 仅收录匹配此正则的页面（文章 URL 形态）；留空则收录全部。
  # 学校 CMS 场景示例：'(/info/|content\.jsp|\.pdf)'（排除栏目/列表页 .htm）
  article_url_pattern: ''
